{
  "name": "@openclaw/vk",
  "version": "2026.4.4",
  "private": true,
  "description": "OpenClaw VK channel plugin",
  "type": "module",
  "devDependencies": {
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "vk",
      "label": "VK",
      "selectionLabel": "VK (Community Bot)",
      "detailLabel": "VK Community Bot",
      "docsPath": "/channels/vk",
      "docsLabel": "vk",
      "blurb": "VK community bot with Long Poll transport.",
      "order": 82,
      "systemImage": "message",
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclaw/vk",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.4"
    }
  }
}
